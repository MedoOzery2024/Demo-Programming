rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'xp', 'level', 'role']) &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 64 &&
             data.xp is number && data.level is number &&
             data.role is string && data.role in ['user', 'admin'];
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().role == 'user';
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().role == existing().role;
      allow update, delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['userId', 'courseId', 'completedLessons', 'updatedAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.courseId is string && data.courseId.size() <= 128 &&
             data.completedLessons is list && data.completedLessons.size() <= 1000 &&
             data.updatedAt is number;
    }

    match /progress/{progressId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Removed the 'exists' check for courses to allow frontend progress tracking without a CMS
      allow create: if isSignedIn() && isValidProgress(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidProgress(incoming()) && incoming().userId == request.auth.uid && incoming().userId == existing().userId && incoming().courseId == existing().courseId;
    }
  }
}
