{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with their gamification stats",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["email", "xp", "level", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "A programming course",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "language": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] }
      },
      "required": ["title", "description", "language", "difficulty"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "A lesson in a course",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["courseId", "title", "content", "order"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Tracks the completed lessons for a user per course",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "completedLessons": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "courseId", "completedLessons", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Store user profiles."
    },
    "courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Store courses."
    },
    "courses/{courseId}/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/Lesson" },
      "description": "Store lessons for a course."
    },
    "progress/{progressId}": {
      "schema": { "$ref": "#/entities/UserProgress" },
      "description": "Store user progress per course."
    }
  }
}
